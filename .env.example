# Copy to .env (never commit it). Everything works without any of these.
# --- where the sample town is (and where complaints are accepted) ---
# Where the sample town is drawn. Complaints are accepted from anywhere.
CITY_CENTER=27.894,77.369
SERVICE_RADIUS_KM=8
# true = the phone must report its own location and the pin must be within 1 km of it. false = no location check (laptop testing).
GEOFENCE=true
# --- real offices and phone numbers for the Help tab ---
# Without a key it uses OpenStreetMap (free; many small-town offices have no phone listed).
# With a Google Maps Platform key (Places API) the phone coverage is much better, but each lookup is billed.
GOOGLE_MAPS_KEY=
# Included in the User-Agent for OpenStreetMap requests (their usage policy asks for a way to contact you)
CONTACT_EMAIL=
# off = do not look anything up (sample contacts only)
PLACES=on
# --- storage: Neo4j Aura (the graph database) ---
# Copy the values from the credentials file Aura gave you when you created the instance. Never commit them.
# NEO4J_URI looks like neo4j+s://xxxxxxxx.databases.neo4j.io (Aura needs neo4j+s://). Leave it empty for in-memory local development.
# NEO4J_USERNAME: the username in that file (older .env files with NEO4J_USER still work).
# NEO4J_DATABASE: the database name in that file, normally neo4j (empty = the instance's default database).
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Production (NODE_ENV=production) refuses to start without NEO4J_URI. Set true only to run a throwaway in-memory demo on purpose.
ALLOW_MEMORY_STORE=false
# --- voice ---
SARVAM_API_KEY=
# Optional Sarvam model overrides (defaults: saaras:v3, sarvam-translate:v1, bulbul:v3 speaker shubh, sarvam-105b)
SARVAM_STT_MODEL=
SARVAM_TRANSLATE_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
SARVAM_CHAT_MODEL=
# --- sign-in ---
# Citizen phone verification: no SMS provider is connected. Leave OTP_CODE empty and every sign-in gets a random
# code that the app shows as a "demo SMS". Set it only for tests/local (then every phone uses that fixed code).
OTP_CODE=
# All sample officer accounts (field1, zonal1, head1, commissioner1) use this password.
OFFICER_PASSWORD=officer@123
# Keeps people signed in across restarts. Set a long random value in production.
ID_SALT=
# Protects /admin and the sample-data buttons. Required when NODE_ENV=production.
ADMIN_KEY=
# Comma-separated web origins allowed to call the API, or * for any.
CORS_ORIGIN=*
# Reads re-use the last detection run for this long (ms); writes always re-run it.
RECOMPUTE_TTL_MS=10000
REQUIRE_OTP=true
PORT=3000
