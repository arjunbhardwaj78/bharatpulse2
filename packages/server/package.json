{
  "name": "@bharatpulse/server",
  "version": "0.1.0",
  "description": "HTTP API that turns citizen complaints into persistent, stable incidents.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "neo4j:smoke": "tsx scripts/smoke.ts neo4j",
    "sarvam:smoke": "tsx scripts/smoke.ts sarvam",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@bharatpulse/engine": "*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "exifr": "^7.1.3",
    "fastify": "^5.0.0",
    "neo4j-driver": "^6.3.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@neo4j-cypher/language-support": "^2.0.0-next.6",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
